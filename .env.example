# Copy to .env.local and fill in real values. .env* is gitignored.

# Google Analytics (public — shipped to the browser)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web3Forms (public — shipped to the browser). Access key for the /contact form.
# Get a free key tied to your submission email at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Inoreader — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Used to pull the curated "World Cup" folder via the Stream Contents endpoint.
# Auth uses OAuth2: a long-lived refresh token is exchanged for short-lived
# access tokens at runtime (Authorization: Bearer <access_token>).
#
# CLIENT_ID / CLIENT_SECRET: from your Inoreader Preferences → Developer page
#   (the registered OAuth application).
# REFRESH_TOKEN: obtained once by running
#   node --env-file=.env.local scripts/get-inoreader-token.mjs
#   (requires CLIENT_ID, CLIENT_SECRET, and INOREADER_REDIRECT_URI set first).
INOREADER_CLIENT_ID=
INOREADER_CLIENT_SECRET=
INOREADER_REFRESH_TOKEN=

# Only needed to RUN the token helper (must exactly match a redirect URI
# registered on your OAuth app). Not used at runtime.
INOREADER_REDIRECT_URI=http://localhost:3000/oauth/callback

# Optional overrides (sensible defaults applied if unset):
# INOREADER_STREAM=user/-/label/World Cup   # folder or saved-search streamId
# INOREADER_ITEM_COUNT=50                    # items to pull per fetch
